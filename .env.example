# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/globallink_db

# Authentication Security
JWT_SECRET=globallink_development_jwt_secret_key_32charsmin!
JWT_EXPIRES_IN=24h

# CORS Whitelist (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_API_KEY=
UPLOAD_API_SECRET=
UPLOAD_CLOUD_NAME=
